# whitelist: ignore everything, then allow what belongs in the repo
*
!*/
!/.gitignore
!/.python-version
!/pyproject.toml
!/uv.lock
!/justfile
!/dynlp/*.py
!/tests/*.py
!/scripts/*
!/results/**
*.md
*.pdf
.venv/
__pycache__/
.pytest_cache/
data/
results/h100/
results/*.tar.gz
results/sanity/
results/*.log
